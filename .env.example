# URL base da aplicação
VITE_APP_URL=https://osauto.konnexy.com.br

# Provedor Backend Supabase (Opcional - em ausência utiliza modo mock/demonstração reativa)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Provedores de Pagamento (Futuro Webhook Pix Baixa Automática)
# PIX_PROVIDER=asaas_or_mercadopago
# PIX_API_KEY=

# Provedor Fiscal (NFS-e / NFC-e)
